generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  users     User[]
  templates Template[]
  apiKeys   ApiKey[]
}

model User {
  id           String     @id @default(uuid())
  name         String?
  email        String     @unique
  passwordHash String?
  role         String     @default("user")
  workspaceId  String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id])
}

model Template {
  id          String    @id @default(uuid())
  name        String
  description String?
  structure   Json      // JSONB format
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ApiKey {
  id          String    @id @default(uuid())
  key         String    @unique
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
